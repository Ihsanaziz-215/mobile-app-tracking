{
  "expo": {
    "name": "Abel PO Tracker",
    "slug": "abel-po-tracker",
    "scheme": "abelpotracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ihsanaziz.abelpotracker"
    },
    "android": {
      "package": "com.ihsanaziz.abelpotracker",
      "adaptiveIcon": {
        "backgroundColor": "#10264F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan PO and carton labels.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
